<Project>
  <!--
    Shared package metadata and versioning.
    - VersionPrefix is the stable semver (e.g. 1.0.0).
    - main publishes:  {VersionPrefix}-preview.{N}
    - prod publishes:  {VersionPrefix}
    Bump VersionPrefix when starting the next release train.
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>ravikumarmistry</Authors>
    <Company>ravikumarmistry</Company>
    <Copyright>Copyright (c) ravikumarmistry</Copyright>
    <Description>Generic query DSL for .NET with providers for Sqlite, SqlServer, and Cosmos DB.</Description>
    <PackageTags>query;dsl;dataql;sqlite;sqlserver;cosmos</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ravikumarmistry/DataQL</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ravikumarmistry/DataQL</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests')) Or '$(MSBuildProjectName)' == 'DataQL.ExampleApi'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)readme.md" Pack="true" PackagePath="README.md" Condition="Exists('$(MSBuildThisFileDirectory)readme.md')" />
  </ItemGroup>
</Project>
