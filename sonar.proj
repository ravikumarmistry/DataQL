<Project DefaultTargets="Scan" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Manual SonarQube scan via signed `dotnet msbuild` (no .cmd / SmartScreen).

    From repo root (cmd or PowerShell):
      dotnet msbuild sonar.proj -t:Scan
      dotnet msbuild sonar.proj -t:Scan -p:SkipTests=true

    Token (first match wins):
      1) -p:SonarToken=...
      2) environment variable SONAR_TOKEN
      3) file .sonar-token (token on its own line)
  -->

  <PropertyGroup>
    <SonarHostUrl Condition="'$(SonarHostUrl)' == ''">http://localhost:9000</SonarHostUrl>
    <SonarProjectKey Condition="'$(SonarProjectKey)' == ''">DataQL</SonarProjectKey>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <SkipTests Condition="'$(SkipTests)' == ''">false</SkipTests>
    <StrictTests Condition="'$(StrictTests)' == ''">false</StrictTests>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</RepoRoot>
  </PropertyGroup>

  <Target Name="ResolveSonarToken">
    <PropertyGroup>
      <_SonarToken>$(SonarToken)</_SonarToken>
      <_SonarToken Condition="'$(_SonarToken)' == ''">$([System.Environment]::GetEnvironmentVariable('SONAR_TOKEN'))</_SonarToken>
    </PropertyGroup>

    <ReadLinesFromFile
        File="$(RepoRoot).sonar-token"
        Condition="'$(_SonarToken)' == '' AND Exists('$(RepoRoot).sonar-token')">
      <Output TaskParameter="Lines" ItemName="_TokenLine" />
    </ReadLinesFromFile>

    <!-- Use the last non-comment, non-empty line -->
    <PropertyGroup Condition="'$(_SonarToken)' == ''">
      <_SonarToken></_SonarToken>
    </PropertyGroup>
    <ItemGroup Condition="'$(_SonarToken)' == ''">
      <_TokenKeep Include="@(_TokenLine)" Condition="'%(Identity)' != '' AND !$([System.String]::Copy('%(Identity)').Trim().StartsWith('#'))" />
    </ItemGroup>
    <PropertyGroup Condition="'$(_SonarToken)' == '' AND '@(_TokenKeep)' != ''">
      <_SonarToken>@(_TokenKeep)</_SonarToken>
    </PropertyGroup>
    <!-- When multiple lines join with ';', take substring after last ';' -->
    <PropertyGroup Condition="'$(_SonarToken)' != '' AND $(_SonarToken.Contains(';'))">
      <_SonarToken>$(_SonarToken.Substring($(_SonarToken.LastIndexOf(';')).Add(1)))</_SonarToken>
    </PropertyGroup>
    <PropertyGroup>
      <_SonarToken>$(_SonarToken.Trim())</_SonarToken>
    </PropertyGroup>

    <Error
        Text="Set SONAR_TOKEN, pass -p:SonarToken=..., or create .sonar-token in the repo root."
        Condition="'$(_SonarToken)' == ''" />
  </Target>

  <Target Name="CleanSonarWorkingDir">
    <Exec WorkingDirectory="$(RepoRoot)" Command="if exist .sonarqube rmdir /S /Q .sonarqube" IgnoreExitCode="true" />
    <Warning
        Text="Could not remove .sonarqube (may be locked). If begin fails, run: rmdir /S /Q .sonarqube"
        Condition="Exists('$(RepoRoot).sonarqube')" />
  </Target>

  <Target Name="SonarBegin" DependsOnTargets="ResolveSonarToken;CleanSonarWorkingDir">
    <Message Importance="high" Text="Starting SonarQube scan for '$(SonarProjectKey)' -> $(SonarHostUrl)" />
    <Exec WorkingDirectory="$(RepoRoot)" Command="dotnet sonarscanner begin /k:&quot;$(SonarProjectKey)&quot; /n:&quot;$(SonarProjectKey)&quot; /d:sonar.host.url=&quot;$(SonarHostUrl)&quot; /d:sonar.token=&quot;$(_SonarToken)&quot; /d:sonar.cs.opencover.reportsPaths=&quot;$(RepoRoot)**/coverage.opencover.xml&quot; /d:sonar.exclusions=&quot;**/bin/**,**/obj/**,**/.vs/**,**/TestResults/**&quot; /d:sonar.coverage.exclusions=&quot;**/*Tests*/**,**/DataQL.ExampleApi/**&quot;" />
  </Target>

  <Target Name="SonarBuild">
    <Exec WorkingDirectory="$(RepoRoot)" Command="dotnet build DataQL.sln -c $(Configuration) --no-incremental" />
  </Target>

  <Target Name="SonarTest" Condition="'$(SkipTests)' != 'true'">
    <Exec
        WorkingDirectory="$(RepoRoot)"
        Command="dotnet test DataQL.sln -c $(Configuration) --no-build --collect:&quot;XPlat Code Coverage&quot; --results-directory TestResults -- DataCollectionRunSettings.DataCollectors.DataCollector.Configuration.Format=opencover"
        IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="_TestExitCode" />
    </Exec>
    <Error Text="Tests failed." Condition="'$(StrictTests)' == 'true' AND '$(_TestExitCode)' != '0'" />
    <Warning Text="Tests failed (exit $(_TestExitCode)). Continuing so Sonar can still upload analysis." Condition="'$(_TestExitCode)' != '0' AND '$(StrictTests)' != 'true'" />
  </Target>

  <Target Name="SonarEnd" DependsOnTargets="ResolveSonarToken">
    <Exec WorkingDirectory="$(RepoRoot)" Command="dotnet sonarscanner end /d:sonar.token=&quot;$(_SonarToken)&quot;" />
    <Message Importance="high" Text="Scan submitted. Open $(SonarHostUrl)/dashboard?id=$(SonarProjectKey)" />
  </Target>

  <Target Name="Scan" DependsOnTargets="SonarBegin;SonarBuild;SonarTest;SonarEnd" />
</Project>
