{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Coverage: HTML Report",
      "type": "shell",
      "command": "dotnet msbuild coverage.proj -t:Report",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Coverage: HTML Report (open)",
      "type": "shell",
      "command": "dotnet msbuild coverage.proj -t:Open",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
